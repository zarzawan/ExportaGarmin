<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GarminDataExport</RootNamespace>
    <AssemblyName>GarminDataExport</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Update="*.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="requirements.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="requirements-windows-lock.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="GarminDataExport.Launcher\**\*.cs" />
    <Compile Remove="GarminDataExport.Tests\**\*.cs" />
  </ItemGroup>

</Project>
